{
  "compilerOptions": {
    "module": "NodeNext", "moduleResolution": "NodeNext", "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "outDir": "lib", "rootDir": "src",
    "strict": true, "skipLibCheck": true, "sourceMap": true, "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts"]
